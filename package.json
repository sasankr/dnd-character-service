{
    "name":  "dnd-character-service",
    "version":  "1.0.0",
    "description":  "Character HP management service and full-stack dashboard for D\u0026D",
    "main":  "dist/index.js",
    "scripts":  {
                    "build":  "tsc",
                    "build:client":  "npm --prefix client run build",
                    "build:all":  "npm run build \u0026\u0026 npm run build:client",
                    "start":  "node dist/index.js",
                    "dev":  "ts-node-dev --respawn --transpile-only src/index.ts",
                    "dev:client":  "npm --prefix client run dev",
                    "dev:all":  "concurrently \"npm run dev\" \"npm run dev:client\"",
                    "test":  "jest",
                    "test:watch":  "jest --watch",
                    "postinstall":  "npm --prefix client install"
                },
    "keywords":  [
                     "dnd",
                     "dnd5e",
                     "hitpoints",
                     "character-service",
                     "typescript",
                     "react"
                 ],
    "author":  "Sasank Reddy Dodda",
    "license":  "ISC",
    "dependencies":  {
                         "cors":  "^2.8.5",
                         "express":  "^4.19.2"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jest":  "^29.5.12",
                            "@types/node":  "^20.12.7",
                            "@types/supertest":  "^6.0.2",
                            "concurrently":  "^8.2.2",
                            "jest":  "^29.7.0",
                            "supertest":  "^6.3.4",
                            "ts-jest":  "^29.1.2",
                            "ts-node-dev":  "^2.0.0",
                            "typescript":  "^5.4.5"
                        }
}
